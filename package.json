{
  "name": "alfieawards.com",
  "version": "0.0.1",
  "description": "alfieawards.com by Adam DJ Brett.",
  "type": "module",
  "scripts": {
    "build": "buildawesome",
    "build-nocolor": "cross-env NODE_DISABLE_COLORS=1 buildawesome",
    "build-ghpages": "buildawesome --pathprefix=/alfieawards.com/",
    "start": "buildawesome --serve --quiet",
    "start-ghpages": "buildawesome --pathprefix=/alfieawards.com/ --serve --quiet",
    "debug": "cross-env DEBUG=Eleventy* buildawesome",
    "debugstart": "cross-env DEBUG=Eleventy* buildawesome --serve --quiet",
    "benchmark": "cross-env DEBUG=Eleventy:Benchmark* buildawesome"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/adamdjbrett/alfieawards.com.git"
  },
  "author": {
    "name": "Adam Dj Brett",
    "email": "info@adamdjbrett.com",
    "url": "https://adamdjbrett.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11.14.0"
  },
  "devDependencies": {
    "@11ty/eleventy-navigation": "1.0.5",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "@awesome.me/buildawesome": "4.0.0-alpha.10",
    "cross-env": "10.1.0",
    "luxon": "3.7.2",
    "markdown-it": "15.0.0",
    "zod": "4.4.3",
    "zod-validation-error": "5.0.0"
  },
  "dependencies": {
    "@zachleat/heading-anchors": "1.0.5"
  },
  "packageManager": "npm@11.14.0"
}
