<div
  id="{{video.section}}"
  data-scroll-id="video"
  data-scroll-behavior="default"
  data-scroll-offset="0"
  data-scroll-speed="3"
  class="style3 container default full screen purple"
>
  <div class="wrapper">
    <div class="inner" data-onvisible-trigger="1">
      <div class="bunny-video">{{ video.embed | safe }}</div>
      {% if video.credit %}<p class="bunny-video-credit">{{ video.credit }}</p>{% endif %}
    </div>
  </div>
</div>
